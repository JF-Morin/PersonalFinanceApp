# ── Rust ──────────────────────────────────────────────────────────────────────
/target/

# ── Secrets & local config ────────────────────────────────────────────────────
# .env contains COOKIE_SECRET and other sensitive values — never commit it.
# Use .env.example (committed) as the template.
.env
.env.local
.env.*.local

# Claude Code local settings — machine-specific permission overrides.
# (.claude/settings.json is shared project config and IS committed.)
.claude/settings.local.json

# ── Runtime data (created automatically at startup) ───────────────────────────
/data/          # SQLite database
/logs/          # Rolling log files
/storage/       # Ingested PDF statements (may contain real bank data)

# ── Test PDFs ─────────────────────────────────────────────────────────────────
# Drop real bank statement PDFs here to iterate on parsers.
/test/

# ── Sensitive file types (wherever they land) ─────────────────────────────────
*.pdf           # Bank statements — may contain real financial data
*.db            # SQLite databases outside /data/
*.sqlite
*.sqlite3
*.pem           # TLS certificates / private keys
*.key
*.p12
*.pfx
backup/
backups/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
