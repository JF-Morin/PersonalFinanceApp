DATABASE_URL=sqlite:./data/finance.db
STORAGE_PATH=./storage
LOG_PATH=./logs
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
# Must be at least 32 characters
COOKIE_SECRET=change-this-to-a-random-secret-32chars
# Log verbosity — use =trace for maximum detail, =warn for quiet. Only the starting
# value: the admin can set the level (and how many days of logs to keep) in Paramètres.
RUST_LOG=personal_finance_app=debug,tower_http=info
# Docker only: local time zone (today's date, current year, backup names)
TZ=America/Toronto
# Docker only: host port mapped to the container's SERVER_PORT (default 3000)
APP_PORT=3000
# Database backups (consistent snapshots, see src/backup.rs) — at startup, then every
# BACKUP_INTERVAL_HOURS (0 = startup only). Keep the BACKUP_KEEP most recent.
BACKUP_DIR=./data/db-backup
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24
